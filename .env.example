# Copia este archivo como ".env" y pon tu token real ahí. Nunca subas el ".env" a GitHub.
BOT_TOKEN=pega_aqui_el_token_de_tu_bot
# URL de conexión Neon (en Render usa un Secret/Environment Variable llamado DATABASE_URL).
DATABASE_URL=
# Dashboard privado. Define una contraseña nueva solo en el entorno del servicio.
DASHBOARD_PASSWORD=
# Secreto aleatorio de al menos 32 bytes para firmar sesiones; configura también en Render.
SESSION_SECRET=
