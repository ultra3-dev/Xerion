# Copia este archivo como ".env" y pon tu token real ahí. Nunca subas el ".env" a GitHub.
BOT_TOKEN=pega_aqui_el_token_de_tu_bot
# URL de conexión Neon (en Render usa un Secret/Environment Variable llamado DATABASE_URL).
DATABASE_URL=
# Secreto privado nuevo de al menos 32 bytes para el dashboard /admin.
DASHBOARD_SECRET=

# ── Opcionales de v1.1.0 (todos tienen un valor por defecto seguro; no hace falta definirlos) ──

# Mesa de blackjack dibujada con canvas propio (imagen PNG ≈ 75 KB). `off` usa el tablero de texto.
# BLACKJACK_CANVAS=on

# Emojis Apple del canvas: se descargan una vez (HTTPS) del paquete emoji-datasource-apple en jsDelivr y se
# guardan en caché. `off` no descarga nada y usa iconos vectoriales de respaldo. También puedes poner tus propios
# PNG de 64×64 en assets/emoji/<codepoint>.png (p. ej. 1f383.png para 🎃).
# XERION_EMOJI_SOURCE=apple
# XERION_EMOJI_BASE_URL=https://cdn.jsdelivr.net/npm/emoji-datasource-apple/img/apple/64
# XERION_EMOJI_CACHE_DIR=/tmp/xerion-emoji-cache

# Ahorro (SOLO con el plan Free de Render, ver docs/COSTOS.md): evita que Render suspenda el servicio.
# KEEP_ALIVE=on
# KEEP_ALIVE_URL=https://tu-servicio.onrender.com   (por defecto RENDER_EXTERNAL_URL)
# KEEP_ALIVE_MINUTES=10
